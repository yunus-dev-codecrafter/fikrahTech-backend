# Application Port
PORT=3000
NODE_ENV=development

# Database Configuration (Postgres; Railway provides DATABASE_URL automatically)
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://username:password@host:port/database

# Alternative: Individual database variables (fallback)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=fikrahtech

# JWT Secret (REQUIRED — server refuses to start without it)
JWT_SECRET=your_strong_random_secret

# Frontend URL for CORS (comma handling is in app.js allow-list)
FRONTEND_URL=https://fikrahtech.vercel.app

# Bootstrap admin (only used when the admin does not exist yet; never resets passwords)
BOOTSTRAP_ADMIN_EMAIL=yunusabdulhameed1@gmail.com
BOOTSTRAP_ADMIN_NAME=Yunus Abdulhamid
# BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-boot
